# Copia a ".env.local" (no se versiona) y ajusta. Reinicia "npm run dev" tras cambiarlo.

# URL del backend. En tu PC: localhost. Desde otro dispositivo: la IP de tu PC en la red.
VITE_API_URL=http://localhost:3000

# Clave pública VAPID de Firebase Cloud Messaging (notificaciones push web)
VITE_FIREBASE_VAPID_KEY=
