# Copia a ".env" (no se versiona). Reinicia Expo con "npx expo start -c" tras cambiarlo.

# URL del backend. Un teléfono real NO puede usar localhost: usa la IP de tu PC en la red
# (ej.: http://192.168.1.10:3000) y revísala cada vez que cambies de red.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Clave PÚBLICA de Stripe (pk_test_...). Nunca pongas aquí la clave secreta.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
