@startuml 04i_sec_plataforma_suscripcion
title Secuencia: el SuperAdmin cambia el plan de una empresa y la suspende
skinparam shadowing false
autonumber
actor SuperAdmin as SA
actor "Administrador de la empresa" as AD
participant "PlatformPage" as UI <<boundary>>
participant "TenantsController" as C
participant "TenantsService" as S
participant "TenantGuard" as G
database PostgreSQL as DB
SA -> UI : elige plan y ciclo (mensual / anual)
UI -> C : PATCH /saas/admin/tenants/:id/plan (JWT SUPERADMIN)
C -> S : adminChangePlan(id, plan, ciclo)
S -> DB : contar sucursales, productos y usuarios en uso
alt el uso supera los límites del plan destino
  S --> UI : 409 reducir el uso primero
else
  S -> DB : UPDATE subscriptions (plan, ciclo, inicio, fin = +1 mes o +1 año)
  S -> DB : INSERT subscription_history (acción, ciclo, precio)
  S --> UI : suscripción actualizada
end
SA -> UI : suspender empresa
UI -> C : PATCH /saas/admin/tenants/:id/active
C -> S : adminSetActive(id, false)
S -> DB : tenants.active = false, subscription = SUSPENDED
AD -> G : cualquier petición con su JWT
G -> DB : ¿empresa activa? (caché 30 s)
G --> AD : 403 empresa suspendida
@enduml
