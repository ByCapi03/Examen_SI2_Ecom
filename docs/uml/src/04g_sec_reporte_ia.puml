@startuml 04g_sec_reporte_ia
title Secuencia: reporte en lenguaje natural (la IA nunca genera SQL)
skinparam shadowing false
autonumber
actor Administrador as AD
participant "AiReportsPage" as UI <<boundary>>
participant "AiReportsService" as S
participant "LLM / intérprete local" as L
participant "Validador de especificación" as V
database PostgreSQL as DB
AD -> UI : "ventas por sucursal del mes"
UI -> S : POST /ai-reports/query
S -> L : interpretar pregunta
L --> S : especificación JSON
S -> V : validar contra listas blancas
V --> S : especificación válida
S -> DB : consulta parametrizada, solo lectura, con tiempo límite
DB --> S : filas (solo de su empresa)
S -> DB : registrar en ai_report_logs
S --> UI : tabla + resumen
@enduml
