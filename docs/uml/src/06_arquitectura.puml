@startuml 06_arquitectura
title Arquitectura del sistema implementado
!pragma layout smetana
skinparam shadowing false
skinparam componentStyle rectangle

actor "Personal\n(Admin / Encargado / Cajero)" as P
actor "Cliente" as C

node "Navegador (PWA)" {
  component "Frontend React + Vite\nlanding · /t/:slug · /dashboard · /account" as FE
  component "IndexedDB + Service Worker\n(cola offline)" as IDB
  component "TensorFlow.js MoveNet\n(vestidor virtual)" as TF
}
node "Dispositivo móvil" {
  component "App Expo / React Native\n(login obligatorio)" as MOB
  component "SQLite (cola offline)" as SQL
}
node "Servidor" {
  component "API NestJS" as API {
    component "TenantContextMiddleware\n(X-Tenant-Slug / JWT)" as MW
    component "AuthGuard · TenantGuard\nRolesGuard · PlanFeatureGuard" as GD
    component "Módulos: auth · tenants · branches · catalog\ninventory · sales · reservations · store\nsync · reports · ai-reports · analytics\naudit · notifications" as MOD
    component "TenantSubscriber (TypeORM)" as SUB
  }
  database "PostgreSQL" as DB
}
cloud "Servicios externos" {
  component "Stripe" as ST
  component "Cloudinary" as CLD
  component "SMTP (correo)" as SM
  component "Firebase (push)" as FB
  component "LLM compatible OpenAI\n(opcional)" as LLM
}

P --> FE
C --> FE
C --> MOB
FE --> IDB
FE --> TF
MOB --> SQL
FE --> API : HTTPS / JSON + JWT
MOB --> API : HTTPS / JSON + JWT
API --> DB
MW --> GD
GD --> MOD
MOD --> SUB
MOD --> ST
MOD --> CLD
MOD --> SM
MOD --> FB
MOD ..> LLM
@enduml
