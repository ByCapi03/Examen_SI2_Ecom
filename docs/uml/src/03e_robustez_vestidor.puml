@startuml 03e_robustez_vestidor
title Robustez CU-23: vestidor virtual
!pragma layout smetana
skinparam shadowing false
hide empty members
left to right direction
actor "Cliente" as ACT
class "Pantalla del vestidor" as B1 << (B,#B3D9FF) Frontera >>
class "Cámara / lienzo" as B2 << (B,#B3D9FF) Frontera >>
class "Cargar datos AR de la prenda" as C1 << (C,#D5F5B8) Control >>
class "Detectar pose (MoveNet)" as C2 << (C,#D5F5B8) Control >>
class "Ajustar prenda al cuerpo" as C3 << (C,#D5F5B8) Control >>
class "Producto (imágenes AR)" as E1 << (E,#FFE9A8) Entidad >>
class "Variante" as E2 << (E,#FFE9A8) Entidad >>
ACT --> B1
B1 --> C1
C1 --> E1
C1 --> E2
B1 --> B2
B2 --> C2
C2 --> C3
C3 --> B2
@enduml
