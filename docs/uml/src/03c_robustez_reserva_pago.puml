@startuml 03c_robustez_reserva_pago
title Robustez CU-24/25: reserva y pago (Stripe / QR) con entrega en sucursal
!pragma layout smetana
skinparam shadowing false
hide empty members
left to right direction
actor "Cliente / Cajero" as ACT
class "Formulario de reserva" as B1 << (B,#B3D9FF) Frontera >>
class "Checkout" as B2 << (B,#B3D9FF) Frontera >>
class "Pago QR móvil" as B3 << (B,#B3D9FF) Frontera >>
class "Pantalla de entrega" as B4 << (B,#B3D9FF) Frontera >>
class "Crear reserva" as C1 << (C,#D5F5B8) Control >>
class "Crear pago" as C2 << (C,#D5F5B8) Control >>
class "Confirmar pago (webhook)" as C3 << (C,#D5F5B8) Control >>
class "Entregar y cobrar" as C4 << (C,#D5F5B8) Control >>
class "Notificar" as C5 << (C,#D5F5B8) Control >>
class "Reserva / Ítems" as E1 << (E,#FFE9A8) Entidad >>
class "Pago" as E2 << (E,#FFE9A8) Entidad >>
class "Inventario" as E3 << (E,#FFE9A8) Entidad >>
class "Venta" as E4 << (E,#FFE9A8) Entidad >>
class "Notificación" as E5 << (E,#FFE9A8) Entidad >>
ACT --> B1
B1 --> C1
C1 --> E1
C1 --> E3
ACT --> B2
B2 --> C2
C2 --> E2
C2 --> B3
C3 --> E2
C3 --> E1
C3 --> C5
C5 --> E5
ACT --> B4
B4 --> C4
C4 --> E1
C4 --> E4
C4 --> E3
@enduml
