@startuml 04e_sec_reserva_pago
title Secuencia: reserva con pago en línea (Stripe) y confirmación
skinparam shadowing false
autonumber
actor Cliente
participant "CheckoutPage" as UI <<boundary>>
participant "ReservationsController" as RC
participant "ReservationsService" as RS
participant "PaymentGatewayService" as PG
participant "Stripe" as ST
database PostgreSQL as DB
Cliente -> UI : confirmar reserva
UI -> RC : POST /reservations
RC -> RS : create(dto)
RS -> DB : reservar stock (transacción)
UI -> RC : POST /reservations/:id/create-payment
RS -> PG : createCheckoutSession (URLs /t/slug)
PG -> ST : crear sesión de pago
ST --> UI : URL de pago
Cliente -> ST : paga
ST -> RC : POST /stripe/webhook
RC -> RS : confirmStripePayment
RS -> DB : pago aprobado + reserva confirmada
RS -> RS : notificar al cliente
@enduml
