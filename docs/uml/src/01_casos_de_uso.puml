@startuml 01_casos_de_uso
title Diagrama de casos de uso - DRESSED (SaaS multitenant para tiendas de ropa)
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle

actor "SuperAdmin\n(plataforma)" as SA
actor "Administrador\n(empresa)" as AD
actor "Encargado\n(sucursal)" as EN
actor "Cajero" as CA
actor "Cliente" as CL
actor "Stripe /\nPasarela" as ST <<sistema>>
actor "Cloudinary" as CLD <<sistema>>
actor "Correo SMTP /\nFirebase (push)" as MAIL <<sistema>>

rectangle "DRESSED" {
  package "Plataforma SaaS" {
    usecase "CU-01 Registrar empresa\ny verificar correo" as CU01
    usecase "CU-02 Gestionar plan de suscripción" as CU02
    usecase "CU-03 Iniciar sesión / cambiar contraseña" as CU03
    usecase "CU-04 Presentar la plataforma\n(landing y planes)" as CU04
  }
  package "Administración de la empresa" {
    usecase "CU-05 Administrar sucursales" as CU05
    usecase "CU-06 Administrar personal y roles" as CU06
    usecase "CU-07 Gestionar catálogo\n(productos, variantes, imágenes, AR)" as CU07
    usecase "CU-08 Gestionar inventario y proveedores" as CU08
    usecase "CU-09 Administrar cajas de la sucursal" as CU09
    usecase "CU-10 Personalizar y compartir\nmi tienda web" as CU10
    usecase "CU-11 Consultar bitácora de auditoría" as CU11
    usecase "CU-12 Configurar apariencia\n(tema, idioma, moneda)" as CU12
  }
  package "Operación de tienda" {
    usecase "CU-13 Abrir y cerrar sesión de caja" as CU13
    usecase "CU-14 Registrar venta en POS\n(efectivo / tarjeta / QR)" as CU14
    usecase "CU-15 Entregar reserva y cobrar" as CU15
    usecase "CU-16 Sincronizar operaciones offline" as CU16
    usecase "CU-17 Resolver conflictos de sincronización" as CU17
  }
  package "Análisis" {
    usecase "CU-18 Ver dashboard y reportes\n(con dictado por voz)" as CU18
    usecase "CU-19 Solicitar reporte con IA\n(lenguaje natural)" as CU19
    usecase "CU-20 Consultar analítica ML\n(demanda y segmentos RFM)" as CU20
  }
  package "Tienda en línea (por empresa)" {
    usecase "CU-21 Consultar catálogo público\nde la empresa (/t/slug)" as CU21
    usecase "CU-22 Registrarse como cliente\nde una tienda / activar cuenta" as CU22
    usecase "CU-23 Probar prenda en el vestidor virtual" as CU23
    usecase "CU-24 Reservar prendas" as CU24
    usecase "CU-25 Comprar en línea (checkout)" as CU25
    usecase "CU-26 Consultar mis reservas y compras" as CU26
    usecase "CU-27 Recibir notificaciones" as CU27
  }
}

SA --> CU01
SA --> CU02
AD --> CU01
AD --> CU02
AD --> CU05
AD --> CU06
AD --> CU07
AD --> CU08
AD --> CU10
AD --> CU11
AD --> CU19
AD --> CU20
EN --> CU08
EN --> CU09
EN --> CU17
EN --> CU18
EN --> CU19
EN --> CU20
EN --> CU06
CA --> CU13
CA --> CU14
CA --> CU15
AD --> CU18
AD --> CU09
AD --> CU12
EN --> CU12
CA --> CU12
CL --> CU22
CL --> CU21
CL --> CU23
CL --> CU24
CL --> CU25
CL --> CU26
CL --> CU27

AD --> CU03
EN --> CU03
CA --> CU03
CL --> CU03
CL --> CU04

CU14 ..> CU16 : <<include>>
CU24 ..> CU16 : <<include>>
CU25 ..> ST : pago
CU15 ..> ST : pago QR
CU07 ..> CLD : imágenes
CU22 ..> MAIL : código de activación
CU01 ..> MAIL : código de verificación
CU27 ..> MAIL : push
CU21 <.. CU23 : <<extend>>
CU21 <.. CU24 : <<extend>>
CU21 <.. CU25 : <<extend>>
CU14 ..> CU13 : <<include>>
@enduml
