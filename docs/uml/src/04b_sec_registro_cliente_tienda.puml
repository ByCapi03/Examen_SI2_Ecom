@startuml 04b_sec_registro_cliente_tienda
title Secuencia: registro de cliente en la tienda de una empresa (/register?tenant=slug)
skinparam shadowing false
autonumber
actor Cliente
participant "RegisterPage / RegisterScreen" as UI <<boundary>>
participant "TenantContextMiddleware" as MW
participant "AuthController" as C
participant "AuthService" as S
database PostgreSQL as DB
Cliente -> UI : datos + código de tienda
UI -> C : POST /auth/register (X-Tenant-Slug)
C -> MW : (antes) resolver slug -> publicTenantId
MW -> DB : SELECT id FROM tenants WHERE slug
C -> S : registerClient(dto)
S -> S : requireTenantId() (404 si no existe, 400 si falta)
S -> DB : crear User(tenantId) y Client(tenantId)
S --> UI : accessToken + user
UI -> UI : navegar a /t/slug
@enduml
