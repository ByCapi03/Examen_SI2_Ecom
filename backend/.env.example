# Copia este archivo a ".env" y completa los valores. NUNCA subas ".env" a git.

# --- Servidor ---
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
QR_PUBLIC_WEB_URL=http://localhost:5173

# --- Base de datos (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=ecommerce_ropa
# true solo en desarrollo; en producción usar migraciones (false)
DB_SYNCHRONIZE=true

# --- Autenticación JWT ---
# Cadena aleatoria larga (ej.: openssl rand -hex 32)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- Correo (Gmail con contraseña de aplicación, 2FA activado) ---
SMTP_USER=
SMTP_PASSWORD=

# --- Stripe (pagos) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Moneda ISO en minúsculas (bob, usd). NO es una clave.
STRIPE_CURRENCY=bob
# En desarrollo permite simular pagos; en producción dejar en false
PAYMENT_SIMULATION_ENABLED=true

# --- Reportes con IA ---
# local  = motor propio sin costo (por defecto)
# ollama = modelo local (AI_API_URL=http://localhost:11434, AI_MODEL=qwen2.5:3b)
# openai = requiere AI_API_KEY (AI_MODEL=gpt-4o-mini)
AI_PROVIDER=local
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# --- Imágenes (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Multitenant ---
# Empresa a la que se asignan registros públicos sin tenant (id de tenants)
DEFAULT_TENANT_ID=1
