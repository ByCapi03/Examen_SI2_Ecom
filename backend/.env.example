# Copia este archivo como ".env" (en la carpeta backend) y completa tus valores.
# El archivo .env NO se sube a git: nunca compartas tus claves.

# ── Base de datos (PostgreSQL) ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=tu_password
DB_DATABASE=ecommerce_ropa
# Solo desarrollo: crea/actualiza las tablas automáticamente. En producción usar false.
DB_SYNCHRONIZE=true
# ── En la nube (Neon, Supabase, Render…): usa DATABASE_URL en lugar de DB_HOST/DB_PORT/… ──
# DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=require
# DB_SSL=true

# ── Servidor y seguridad ───────────────────────────────────────────────────
PORT=3000
JWT_SECRET=cambia_esto_por_una_frase_larga_y_secreta
JWT_EXPIRES_IN=8h
# URL del frontend (enlaces de los correos y pagos)
FRONTEND_URL=http://localhost:5173
# Quién puede llamar al API desde un navegador (separados por coma). Vacío = cualquiera (solo desarrollo).
# CORS_ORIGINS=https://mi-web.onrender.com
# En producción poner NODE_ENV=production: el servidor se niega a arrancar sin JWT_SECRET.
# NODE_ENV=production

# ── Imágenes de productos: CLOUDINARY ──────────────────────────────────────
# Sin estas 3 claves NO se pueden subir imágenes (principal ni del vestidor AR).
# Cómo obtenerlas: crea una cuenta gratis en https://cloudinary.com
#   -> Dashboard / "Product Environment Credentials" (o Settings > API Keys)
#   -> copia "Cloud name", "API Key" y "API Secret".
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Correo (verificación de cuentas, contraseñas temporales) ───────────────
# Con Gmail: activa la verificación en 2 pasos y crea una "contraseña de aplicación".
SMTP_USER=
SMTP_PASSWORD=

# ── Pagos con Stripe (opcional) ────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=bob
# Moneda del cobro de las SUSCRIPCIONES (los precios de los planes están en dólares)
STRIPE_PLAN_CURRENCY=usd
# Con STRIPE_SECRET_KEY (sk_test_... o sk_live_...) el cobro de planes es REAL. En Stripe, crea un webhook a
#   POST <URL-del-API>/saas/billing/webhook   (evento checkout.session.completed)   y copia su secreto en STRIPE_WEBHOOK_SECRET
# Permite pagos simulados en producción (solo para pruebas)
PAYMENT_SIMULATION_ENABLED=false

# ── Reportes con IA generativa (opcional) ──────────────────────────────────
# Sin esto se usa el intérprete local de lenguaje natural.
#   AI_PROVIDER=local  → motor propio sin costo (por defecto)
#   AI_PROVIDER=ollama → modelo local (AI_API_URL=http://localhost:11434, AI_MODEL=qwen2.5:3b)
#   AI_PROVIDER=openai → requiere AI_API_KEY (AI_MODEL=gpt-4o-mini)
AI_PROVIDER=local
AI_API_KEY=
AI_API_URL=
AI_MODEL=

# ── Notificaciones push: FIREBASE (FCM) ────────────────────────────────────
# Consola de Firebase -> Configuración del proyecto -> Cuentas de servicio -> "Generar nueva clave privada".
# Guarde el JSON FUERA del repositorio y apunte a su ruta absoluta. Sin esto NO se envían push
# (las notificaciones internas de la campana siguen funcionando).
GOOGLE_APPLICATION_CREDENTIALS=
# En un hosting sin archivos: pega aquí TODO el contenido del JSON de la cuenta de servicio (en una sola línea).
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── SuperAdmin de la plataforma (panel de empresas, planes y suspensiones) ─
# Si defines ambos valores, se crea (una sola vez) el usuario SUPERADMIN al arrancar.
# Usa una contraseña fuerte; no se crea ningún SuperAdmin por defecto.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# ── Otros ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# Dirección pública del frontend para los QR de cobro y los retornos de pago. Déjala VACÍA en desarrollo:
# el QR usa solo la dirección desde la que abriste el POS (p. ej. http://192.168.0.11:5173, para que el
# celular lo pueda abrir). Al desplegar, pon FRONTEND_URL con tu dominio (https://...) y todo lo usará.
QR_PUBLIC_WEB_URL=
# Empresa a la que se asignan registros públicos sin empresa (id en la tabla tenants)
DEFAULT_TENANT_ID=1
